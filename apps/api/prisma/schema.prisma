generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED

  @@map("booking_status")
}

enum StaffRole {
  ADMIN
  RECEPTIONIST

  @@map("staff_role")
}

model Hotel {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique @db.VarChar(120)
  name         String     @db.VarChar(160)
  address      String     @db.VarChar(500)
  description  String     @db.Text
  timezone     String     @default("Asia/Tehran") @db.VarChar(64)
  contactPhone String?    @map("contact_phone") @db.VarChar(32)
  contactEmail String?    @map("contact_email") @db.VarChar(254)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  roomTypes    RoomType[]

  @@map("hotels")
}

model RoomType {
  id               String               @id @default(uuid()) @db.Uuid
  hotelId          String               @map("hotel_id") @db.Uuid
  name             String               @db.VarChar(120)
  slug             String               @db.VarChar(120)
  description      String               @db.Text
  maxGuestsPerRoom Int                  @map("max_guests_per_room")
  amenities        String[]             @default([])
  isActive         Boolean              @default(true) @map("is_active")
  displayOrder     Int                  @default(0) @map("display_order")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotel            Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  inventory        RoomNightInventory[]
  bookings         Booking[]

  @@unique([hotelId, slug])
  @@index([hotelId, isActive, displayOrder])
  @@map("room_types")
}

model RoomNightInventory {
  id                String   @id @default(uuid()) @db.Uuid
  roomTypeId        String   @map("room_type_id") @db.Uuid
  stayDate          DateTime @map("stay_date") @db.Date
  totalRooms        Int      @map("total_rooms")
  heldRooms         Int      @default(0) @map("held_rooms")
  bookedRooms       Int      @default(0) @map("booked_rooms")
  nightlyPriceToman BigInt   @map("nightly_price_toman")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  roomType          RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@unique([roomTypeId, stayDate])
  @@index([stayDate])
  @@map("room_night_inventory")
}

model Booking {
  id              String         @id @default(uuid()) @db.Uuid
  publicReference String         @unique @map("public_reference") @db.VarChar(16)
  idempotencyKey  String?        @unique @map("idempotency_key") @db.VarChar(128)
  status          BookingStatus  @default(PENDING_CONFIRMATION)
  checkIn         DateTime       @map("check_in") @db.Date
  checkOut        DateTime       @map("check_out") @db.Date
  guestCount      Int            @map("guest_count")
  roomTypeId      String         @map("room_type_id") @db.Uuid
  roomQuantity    Int            @map("room_quantity")
  guestName       String         @map("guest_name") @db.VarChar(160)
  guestPhone      String         @map("guest_phone") @db.VarChar(32)
  guestEmail      String?        @map("guest_email") @db.VarChar(254)
  totalPriceToman BigInt         @map("total_price_toman")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  confirmedAt     DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  rejectedAt      DateTime?      @map("rejected_at") @db.Timestamptz(3)
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  expiredAt       DateTime?      @map("expired_at") @db.Timestamptz(3)
  roomType        RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  nights          BookingNight[]

  @@index([status, createdAt])
  @@index([status, checkIn])
  @@index([roomTypeId, checkIn])
  @@map("bookings")
}

model BookingNight {
  id                String   @id @default(uuid()) @db.Uuid
  bookingId         String   @map("booking_id") @db.Uuid
  stayDate          DateTime @map("stay_date") @db.Date
  nightlyPriceToman BigInt   @map("nightly_price_toman")
  roomQuantity      Int      @map("room_quantity")
  amountToman       BigInt   @map("amount_toman")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, stayDate])
  @@index([stayDate])
  @@map("booking_nights")
}

model StaffUser {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique @db.VarChar(120)
  email        String         @unique @db.VarChar(254)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         StaffRole      @default(RECEPTIONIST)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     StaffSession[]

  @@index([isActive, role])
  @@map("staff_users")
}

model StaffSession {
  id            String    @id @default(uuid()) @db.Uuid
  staffUserId   String    @map("staff_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, expiresAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}
