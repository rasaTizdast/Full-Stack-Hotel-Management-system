generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW

  @@map("booking_status")
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
  MANAGER
  HOUSEKEEPER
  CASHIER

  @@map("staff_role")
}

enum FolioStatus {
  OPEN
  CLOSED
  CLOSED_DUE

  @@map("folio_status")
}

enum FolioDirection {
  DEBIT
  CREDIT

  @@map("folio_direction")
}

enum FolioEntryKind {
  ACCOMMODATION
  SERVICE
  FEE
  TAX
  DISCOUNT
  ADJUSTMENT
  PAYMENT
  REFUND

  @@map("folio_entry_kind")
}

enum PaymentMethod {
  CASH
  BANK_TERMINAL
  BANK_TRANSFER
  OTHER

  @@map("payment_method")
}

enum HousekeepingStatus {
  DIRTY
  CLEAN
  INSPECTED

  @@map("housekeeping_status")
}

enum RoomBlockKind {
  OUT_OF_ORDER
  CAPACITY_CLOSED

  @@map("room_block_kind")
}

enum HousekeepingTaskType {
  DEPARTURE_CLEAN
  STAYOVER_CLEAN
  INSPECTION
  GUEST_REQUEST
  RE_CLEAN

  @@map("housekeeping_task_type")
}

enum HousekeepingTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("housekeeping_task_status")
}

enum HousekeepingPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("housekeeping_priority")
}

enum HousekeepingCompletionOutcome {
  DONE
  NEEDS_REWORK

  @@map("housekeeping_completion_outcome")
}

enum RoomDiscrepancyType {
  SLEEP
  SKIP

  @@map("room_discrepancy_type")
}

enum RoomDiscrepancyStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("room_discrepancy_status")
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  SAFETY
  OTHER

  @@map("maintenance_category")
}

enum MaintenanceRequestStatus {
  OPEN
  RESOLVED

  @@map("maintenance_request_status")
}

model Hotel {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique @db.VarChar(120)
  name         String     @db.VarChar(160)
  address      String     @db.VarChar(500)
  description  String     @db.Text
  timezone     String     @default("Asia/Tehran") @db.VarChar(64)
  contactPhone String?    @map("contact_phone") @db.VarChar(32)
  contactEmail String?    @map("contact_email") @db.VarChar(254)
  checkInTime  String     @default("15:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime String     @default("11:00") @map("check_out_time") @db.VarChar(5)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  roomTypes    RoomType[]
  rooms        Room[]

  @@map("hotels")
}

model RoomType {
  id               String               @id @default(uuid()) @db.Uuid
  hotelId          String               @map("hotel_id") @db.Uuid
  name             String               @db.VarChar(120)
  slug             String               @db.VarChar(120)
  description      String               @db.Text
  maxGuestsPerRoom Int                  @map("max_guests_per_room")
  amenities        String[]             @default([])
  isActive         Boolean              @default(true) @map("is_active")
  displayOrder     Int                  @default(0) @map("display_order")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotel            Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  inventory        RoomNightInventory[]
  bookings         Booking[]
  rooms            Room[]

  @@unique([hotelId, slug])
  @@unique([id, hotelId])
  @@index([hotelId, isActive, displayOrder])
  @@map("room_types")
}

model Room {
  id                  String               @id @default(uuid()) @db.Uuid
  hotelId             String               @map("hotel_id") @db.Uuid
  roomTypeId          String               @map("room_type_id") @db.Uuid
  roomNumber          String               @map("room_number") @db.VarChar(32)
  floor               String?              @db.VarChar(32)
  features            String[]             @default([])
  housekeepingStatus  HousekeepingStatus   @default(DIRTY) @map("housekeeping_status")
  isActive            Boolean              @default(true) @map("is_active")
  isGenerated         Boolean              @default(false) @map("is_generated")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType            RoomType             @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Restrict)
  blocks              RoomBlock[]
  assignments         RoomAssignment[]
  housekeepingTasks   HousekeepingTask[]
  discrepancies       RoomDiscrepancy[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([hotelId, roomNumber])
  @@unique([id, roomTypeId])
  @@index([roomTypeId, isActive, roomNumber])
  @@index([roomTypeId, floor, isActive])
  @@map("rooms")
}

model RoomBlock {
  id                   String        @id @default(uuid()) @db.Uuid
  roomId               String        @map("room_id") @db.Uuid
  startDate            DateTime      @map("start_date") @db.Date
  endDate              DateTime      @map("end_date") @db.Date
  kind                 RoomBlockKind @default(OUT_OF_ORDER)
  reason               String        @db.VarChar(500)
  isActive             Boolean       @default(true) @map("is_active")
  createdByStaffUserId String?       @map("created_by_staff_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  room                 Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy            StaffUser?    @relation("RoomBlockCreator", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)

  @@index([roomId, isActive, startDate, endDate])
  @@index([startDate, endDate])
  @@map("room_blocks")
}

model RoomAssignment {
  id                    String       @id @default(uuid()) @db.Uuid
  bookingId             String       @map("booking_id") @db.Uuid
  roomId                String       @map("room_id") @db.Uuid
  roomTypeId            String       @map("room_type_id") @db.Uuid
  startDate             DateTime     @map("start_date") @db.Date
  endDate               DateTime     @map("end_date") @db.Date
  isActive              Boolean      @default(true) @map("is_active")
  assignedByStaffUserId String?      @map("assigned_by_staff_user_id") @db.Uuid
  changeReason          String?      @map("change_reason") @db.VarChar(500)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking               Booking      @relation(fields: [bookingId, roomTypeId], references: [id, roomTypeId], onDelete: Restrict)
  room                  Room         @relation(fields: [roomId, roomTypeId], references: [id, roomTypeId], onDelete: Restrict)
  assignedBy            StaffUser?   @relation("RoomAssignmentCreator", fields: [assignedByStaffUserId], references: [id], onDelete: SetNull)
  folioEntries          FolioEntry[]

  @@index([roomId, isActive, startDate, endDate])
  @@index([bookingId, isActive])
  @@index([startDate, endDate])
  @@map("room_assignments")
}

model HousekeepingTask {
  id                     String                         @id @default(uuid()) @db.Uuid
  roomId                 String                         @map("room_id") @db.Uuid
  taskType               HousekeepingTaskType           @map("task_type")
  businessDate           DateTime                       @map("business_date") @db.Date
  priority               HousekeepingPriority           @default(NORMAL)
  status                 HousekeepingTaskStatus         @default(OPEN)
  assignedToStaffUserId  String?                        @map("assigned_to_staff_user_id") @db.Uuid
  assignedAt             DateTime?                      @map("assigned_at") @db.Timestamptz(3)
  assignedByStaffUserId  String?                        @map("assigned_by_staff_user_id") @db.Uuid
  createdByStaffUserId   String                         @map("created_by_staff_user_id") @db.Uuid
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt              DateTime?                      @map("started_at") @db.Timestamptz(3)
  startedByStaffUserId   String?                        @map("started_by_staff_user_id") @db.Uuid
  completedAt            DateTime?                      @map("completed_at") @db.Timestamptz(3)
  completedByStaffUserId String?                        @map("completed_by_staff_user_id") @db.Uuid
  completionOutcome      HousekeepingCompletionOutcome? @map("completion_outcome")
  completionReason       String?                        @map("completion_reason") @db.VarChar(500)
  reworkOfTaskId         String?                        @unique @map("rework_of_task_id") @db.Uuid
  cancelledAt            DateTime?                      @map("cancelled_at") @db.Timestamptz(3)
  cancelledByStaffUserId String?                        @map("cancelled_by_staff_user_id") @db.Uuid
  cancellationReason     String?                        @map("cancellation_reason") @db.VarChar(500)
  note                   String?                        @db.VarChar(500)
  room                   Room                           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedTo             StaffUser?                     @relation("HousekeepingTaskAssignee", fields: [assignedToStaffUserId], references: [id], onDelete: Restrict)
  assignedBy             StaffUser?                     @relation("HousekeepingTaskAssigner", fields: [assignedByStaffUserId], references: [id], onDelete: Restrict)
  createdBy              StaffUser                      @relation("HousekeepingTaskCreator", fields: [createdByStaffUserId], references: [id], onDelete: Restrict)
  startedBy              StaffUser?                     @relation("HousekeepingTaskStarter", fields: [startedByStaffUserId], references: [id], onDelete: Restrict)
  completedBy            StaffUser?                     @relation("HousekeepingTaskCompleter", fields: [completedByStaffUserId], references: [id], onDelete: Restrict)
  cancelledBy            StaffUser?                     @relation("HousekeepingTaskCanceller", fields: [cancelledByStaffUserId], references: [id], onDelete: Restrict)
  reworkOfTask           HousekeepingTask?              @relation("HousekeepingTaskRework", fields: [reworkOfTaskId], references: [id], onDelete: Restrict)
  reCleanTask            HousekeepingTask?              @relation("HousekeepingTaskRework")

  @@index([roomId, businessDate, status])
  @@index([status, businessDate, priority])
  @@index([assignedToStaffUserId, status, businessDate])
  @@index([taskType, businessDate])
  @@map("housekeeping_tasks")
}

model RoomDiscrepancy {
  id                    String                @id @default(uuid()) @db.Uuid
  roomId                String                @map("room_id") @db.Uuid
  businessDate          DateTime              @map("business_date") @db.Date
  kind                  RoomDiscrepancyType
  expectedOccupied      Boolean               @map("expected_occupied")
  observedOccupied      Boolean               @map("observed_occupied")
  status                RoomDiscrepancyStatus @default(OPEN)
  reportedByStaffUserId String                @map("reported_by_staff_user_id") @db.Uuid
  reportedAt            DateTime              @default(now()) @map("reported_at") @db.Timestamptz(3)
  note                  String                @db.VarChar(500)
  resolvedByStaffUserId String?               @map("resolved_by_staff_user_id") @db.Uuid
  resolvedAt            DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolutionReason      String?               @map("resolution_reason") @db.VarChar(500)
  room                  Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reportedBy            StaffUser             @relation("RoomDiscrepancyReporter", fields: [reportedByStaffUserId], references: [id], onDelete: Restrict)
  resolvedBy            StaffUser?            @relation("RoomDiscrepancyResolver", fields: [resolvedByStaffUserId], references: [id], onDelete: Restrict)

  @@index([roomId, businessDate, status])
  @@index([status, businessDate])
  @@index([reportedByStaffUserId, reportedAt])
  @@map("room_discrepancies")
}

model MaintenanceRequest {
  id                    String                   @id @default(uuid()) @db.Uuid
  roomId                String                   @map("room_id") @db.Uuid
  category              MaintenanceCategory
  description           String                   @db.VarChar(1000)
  priority              HousekeepingPriority     @default(NORMAL)
  status                MaintenanceRequestStatus @default(OPEN)
  expectedDate          DateTime                 @map("expected_date") @db.Date
  assignedToStaffUserId String?                  @map("assigned_to_staff_user_id") @db.Uuid
  assignedAt            DateTime?                @map("assigned_at") @db.Timestamptz(3)
  assignedByStaffUserId String?                  @map("assigned_by_staff_user_id") @db.Uuid
  createdByStaffUserId  String                   @map("created_by_staff_user_id") @db.Uuid
  openedAt              DateTime                 @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt            DateTime?                @map("resolved_at") @db.Timestamptz(3)
  resolvedByStaffUserId String?                  @map("resolved_by_staff_user_id") @db.Uuid
  resolutionNote        String?                  @map("resolution_note") @db.VarChar(500)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  room                  Room                     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedTo            StaffUser?               @relation("MaintenanceRequestAssignee", fields: [assignedToStaffUserId], references: [id], onDelete: Restrict)
  assignedBy            StaffUser?               @relation("MaintenanceRequestAssigner", fields: [assignedByStaffUserId], references: [id], onDelete: Restrict)
  createdBy             StaffUser                @relation("MaintenanceRequestCreator", fields: [createdByStaffUserId], references: [id], onDelete: Restrict)
  resolvedBy            StaffUser?               @relation("MaintenanceRequestResolver", fields: [resolvedByStaffUserId], references: [id], onDelete: Restrict)

  @@index([roomId, status, openedAt])
  @@index([status, expectedDate, priority])
  @@index([assignedToStaffUserId, status, expectedDate])
  @@index([createdAt])
  @@map("maintenance_requests")
}

model RoomNightInventory {
  id                String   @id @default(uuid()) @db.Uuid
  roomTypeId        String   @map("room_type_id") @db.Uuid
  stayDate          DateTime @map("stay_date") @db.Date
  totalRooms        Int      @map("total_rooms")
  blockedRooms      Int      @default(0) @map("blocked_rooms")
  heldRooms         Int      @default(0) @map("held_rooms")
  bookedRooms       Int      @default(0) @map("booked_rooms")
  nightlyPriceToman BigInt   @map("nightly_price_toman")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  roomType          RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@unique([roomTypeId, stayDate])
  @@index([stayDate])
  @@map("room_night_inventory")
}

model Booking {
  id                      String           @id @default(uuid()) @db.Uuid
  publicReference         String           @unique @map("public_reference") @db.VarChar(16)
  idempotencyKey          String?          @unique @map("idempotency_key") @db.VarChar(128)
  idempotencyRequestHash  String?          @map("idempotency_request_hash") @db.Char(64)
  status                  BookingStatus    @default(PENDING_CONFIRMATION)
  checkIn                 DateTime         @map("check_in") @db.Date
  checkOut                DateTime         @map("check_out") @db.Date
  actualDepartureDate     DateTime?        @map("actual_departure_date") @db.Date
  guestCount              Int              @map("guest_count")
  roomTypeId              String           @map("room_type_id") @db.Uuid
  roomQuantity            Int              @map("room_quantity")
  guestName               String           @map("guest_name") @db.VarChar(160)
  guestPhone              String           @map("guest_phone") @db.VarChar(32)
  guestEmail              String?          @map("guest_email") @db.VarChar(254)
  totalPriceToman         BigInt           @map("total_price_toman")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt               DateTime         @map("expires_at") @db.Timestamptz(3)
  confirmedAt             DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  rejectedAt              DateTime?        @map("rejected_at") @db.Timestamptz(3)
  cancelledAt             DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  expiredAt               DateTime?        @map("expired_at") @db.Timestamptz(3)
  checkedInAt             DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  checkedInByStaffUserId  String?          @map("checked_in_by_staff_user_id") @db.Uuid
  checkedOutAt            DateTime?        @map("checked_out_at") @db.Timestamptz(3)
  checkedOutByStaffUserId String?          @map("checked_out_by_staff_user_id") @db.Uuid
  noShowAt                DateTime?        @map("no_show_at") @db.Timestamptz(3)
  noShowByStaffUserId     String?          @map("no_show_by_staff_user_id") @db.Uuid
  noShowReason            String?          @map("no_show_reason") @db.VarChar(500)
  internalNote            String?          @map("internal_note") @db.VarChar(1000)
  cancellationReason      String?          @map("cancellation_reason") @db.VarChar(500)
  roomType                RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  checkedInBy             StaffUser?       @relation("BookingCheckInActor", fields: [checkedInByStaffUserId], references: [id], onDelete: Restrict)
  checkedOutBy            StaffUser?       @relation("BookingCheckOutActor", fields: [checkedOutByStaffUserId], references: [id], onDelete: Restrict)
  noShowBy                StaffUser?       @relation("BookingNoShowActor", fields: [noShowByStaffUserId], references: [id], onDelete: Restrict)
  nights                  BookingNight[]
  assignments             RoomAssignment[]
  folio                   Folio?

  @@unique([id, roomTypeId])
  @@index([status, createdAt])
  @@index([status, checkIn])
  @@index([status, checkOut])
  @@index([roomTypeId, checkIn])
  @@map("bookings")
}

model BookingNight {
  id                String   @id @default(uuid()) @db.Uuid
  bookingId         String   @map("booking_id") @db.Uuid
  stayDate          DateTime @map("stay_date") @db.Date
  nightlyPriceToman BigInt   @map("nightly_price_toman")
  roomQuantity      Int      @map("room_quantity")
  amountToman       BigInt   @map("amount_toman")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, stayDate])
  @@index([stayDate])
  @@map("booking_nights")
}

model ServiceItem {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(120)
  nameKey           String       @unique @map("name_key") @db.VarChar(512)
  category          String       @db.VarChar(80)
  currentPriceToman BigInt       @map("current_price_toman")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  folioEntries      FolioEntry[]

  @@index([isActive, category, name])
  @@map("service_items")
}

model Folio {
  id                     String       @id @default(uuid()) @db.Uuid
  bookingId              String       @unique @map("booking_id") @db.Uuid
  status                 FolioStatus  @default(OPEN)
  closedAt               DateTime?    @map("closed_at") @db.Timestamptz(3)
  closedByStaffUserId    String?      @map("closed_by_staff_user_id") @db.Uuid
  checkoutIdempotencyKey String?      @unique @map("checkout_idempotency_key") @db.VarChar(200)
  checkoutRequestHash    String?      @map("checkout_request_hash") @db.Char(64)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking                Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  closedBy               StaffUser?   @relation("FolioCloser", fields: [closedByStaffUserId], references: [id], onDelete: Restrict)
  entries                FolioEntry[]

  @@map("folios")
}

model FolioEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  entryNumber         BigInt          @unique @default(autoincrement()) @map("entry_number")
  folioId             String          @map("folio_id") @db.Uuid
  direction           FolioDirection
  kind                FolioEntryKind
  amountToman         BigInt          @map("amount_toman")
  serviceDate         DateTime        @map("service_date") @db.Date
  descriptionSnapshot String          @map("description_snapshot") @db.VarChar(500)
  quantity            Int?
  unitAmountToman     BigInt?         @map("unit_amount_toman")
  roomAssignmentId    String?         @map("room_assignment_id") @db.Uuid
  roomNumberSnapshot  String?         @map("room_number_snapshot") @db.VarChar(32)
  serviceItemId       String?         @map("service_item_id") @db.Uuid
  source              String          @db.VarChar(32)
  paymentMethod       PaymentMethod?  @map("payment_method")
  paymentReference    String?         @map("payment_reference") @db.VarChar(120)
  idempotencyKey      String?         @unique @map("idempotency_key") @db.VarChar(200)
  requestHash         String?         @map("request_hash") @db.Char(64)
  actorStaffUserId    String?         @map("actor_staff_user_id") @db.Uuid
  correctsEntryId     String?         @map("corrects_entry_id") @db.Uuid
  correctionReason    String?         @map("correction_reason") @db.VarChar(500)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  folio               Folio           @relation(fields: [folioId], references: [id], onDelete: Restrict)
  roomAssignment      RoomAssignment? @relation(fields: [roomAssignmentId], references: [id], onDelete: Restrict)
  serviceItem         ServiceItem?    @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  actor               StaffUser?      @relation("FolioEntryActor", fields: [actorStaffUserId], references: [id], onDelete: Restrict)
  correctsEntry       FolioEntry?     @relation("FolioCorrection", fields: [correctsEntryId, folioId], references: [id, folioId], onDelete: Restrict)
  corrections         FolioEntry[]    @relation("FolioCorrection")

  @@unique([id, folioId])
  @@index([folioId, serviceDate, entryNumber])
  @@index([roomAssignmentId, serviceDate])
  @@index([correctsEntryId])
  @@map("folio_entries")
}

model StaffUser {
  id                                String               @id @default(uuid()) @db.Uuid
  username                          String               @unique @db.VarChar(120)
  email                             String               @unique @db.VarChar(254)
  passwordHash                      String               @map("password_hash") @db.VarChar(255)
  role                              StaffRole            @default(RECEPTIONIST)
  isActive                          Boolean              @default(true) @map("is_active")
  mustChangePassword                Boolean              @default(false) @map("must_change_password")
  createdAt                         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                          StaffSession[]
  createdRoomBlocks                 RoomBlock[]          @relation("RoomBlockCreator")
  createdRoomAssignments            RoomAssignment[]     @relation("RoomAssignmentCreator")
  checkedInBookings                 Booking[]            @relation("BookingCheckInActor")
  checkedOutBookings                Booking[]            @relation("BookingCheckOutActor")
  noShowBookings                    Booking[]            @relation("BookingNoShowActor")
  createdHousekeepingTasks          HousekeepingTask[]   @relation("HousekeepingTaskCreator")
  assignedHousekeepingTasks         HousekeepingTask[]   @relation("HousekeepingTaskAssignee")
  assignedHousekeepingTaskHistory   HousekeepingTask[]   @relation("HousekeepingTaskAssigner")
  startedHousekeepingTasks          HousekeepingTask[]   @relation("HousekeepingTaskStarter")
  completedHousekeepingTasks        HousekeepingTask[]   @relation("HousekeepingTaskCompleter")
  cancelledHousekeepingTasks        HousekeepingTask[]   @relation("HousekeepingTaskCanceller")
  reportedRoomDiscrepancies         RoomDiscrepancy[]    @relation("RoomDiscrepancyReporter")
  resolvedRoomDiscrepancies         RoomDiscrepancy[]    @relation("RoomDiscrepancyResolver")
  createdMaintenanceRequests        MaintenanceRequest[] @relation("MaintenanceRequestCreator")
  assignedMaintenanceRequests       MaintenanceRequest[] @relation("MaintenanceRequestAssignee")
  assignedMaintenanceRequestHistory MaintenanceRequest[] @relation("MaintenanceRequestAssigner")
  resolvedMaintenanceRequests       MaintenanceRequest[] @relation("MaintenanceRequestResolver")
  auditEvents                       AuditEvent[]
  closedFolios                      Folio[]              @relation("FolioCloser")
  createdFolioEntries               FolioEntry[]         @relation("FolioEntryActor")

  @@index([isActive, role])
  @@map("staff_users")
}

model AuditEvent {
  id               String     @id @default(uuid()) @db.Uuid
  actorStaffUserId String?    @map("actor_staff_user_id") @db.Uuid
  eventName        String     @map("event_name") @db.VarChar(80)
  targetType       String     @map("target_type") @db.VarChar(80)
  targetId         String     @map("target_id") @db.VarChar(128)
  reason           String?    @db.VarChar(500)
  before           Json?      @db.JsonB
  after            Json?      @db.JsonB
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  actor            StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: Restrict)

  @@index([actorStaffUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model StaffSession {
  id            String    @id @default(uuid()) @db.Uuid
  staffUserId   String    @map("staff_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, expiresAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}
