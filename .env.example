# Local-only example credentials. Change these for any shared environment.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hotel_app:change-me-local-only@127.0.0.1:5433/hotel_booking?schema=public
# Public server-side API URL used by the Next.js app.
HOTEL_API_BASE_URL=http://localhost:4000/api/v1
# Browser API base URL. Keep the host aligned with WEB_ORIGIN for local SameSite cookies.
NEXT_PUBLIC_HOTEL_API_BASE_URL=http://localhost:4000/api/v1
# Local fictional administrator only. Set a unique password before seeding any shared environment.
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_PASSWORD=change-this-local-demo-password
